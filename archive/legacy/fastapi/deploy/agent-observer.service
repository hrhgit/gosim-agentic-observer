[Unit]
Description=Agent Observer competition platform
After=network.target

[Service]
User=sac
WorkingDirectory=/srv/agent-observer
EnvironmentFile=/srv/agent-observer/.env
ExecStart=/srv/agent-observer/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
