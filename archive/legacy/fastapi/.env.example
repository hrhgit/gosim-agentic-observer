# Copy to .env and edit. All values have safe local defaults.
SAC_SECRET_KEY=change-me-to-a-long-random-string
SAC_DATABASE_URL=sqlite:///./data/app.db
SAC_DATA_DIR=./data
SAC_BASE_URL=http://localhost:8000
SAC_ADMIN_EMAILS=admin@example.org
# Registration open?
SAC_REGISTRATION_OPEN=true
# Max submissions per team per UTC day
SAC_DAILY_SUBMISSION_LIMIT=10
# Agent sandbox
SAC_AGENT_TIMEOUT_SECONDS=600
SAC_AGENT_STEP_TIMEOUT_SECONDS=20
SAC_AGENT_MEMORY_MB=1024
SAC_AGENT_PYTHON=python3
# Optional SMTP for verification / password reset. Leave empty to disable email.
SAC_SMTP_HOST=
SAC_SMTP_PORT=587
SAC_SMTP_USER=
SAC_SMTP_PASSWORD=
SAC_SMTP_FROM=no-reply@example.org

SAC_SECURE_COOKIES=false
SAC_SANDBOX_MODE=subprocess
SAC_WORKER_CONCURRENCY=1
