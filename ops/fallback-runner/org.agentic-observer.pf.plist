<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchDaemon (/Library/LaunchDaemons/): load /etc/pf.conf with the
     observer-fallback anchor and keep pf enabled across reboots. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>org.agentic-observer.pf</string>
  <key>ProgramArguments</key>
  <array>
    <string>/sbin/pfctl</string><string>-E</string><string>-f</string><string>/etc/pf.conf</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
