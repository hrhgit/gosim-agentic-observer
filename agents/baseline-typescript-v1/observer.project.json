{
  "schema_version": "observer-project-v1",
  "protocol": "jsonl-v4",
  "image": "node:22-slim",
  "build": [
    [
      "node",
      "runtime/setup.cjs"
    ],
    [
      "npm",
      "ci",
      "--include=dev"
    ],
    [
      "npm",
      "run",
      "build"
    ]
  ],
  "run": [
    "node",
    "dist/agent.js"
  ],
  "working_directory": ".",
  "environment": {
    "NPM_CONFIG_CACHE": "/workspace/.npm-cache",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false",
    "PYTHONDONTWRITEBYTECODE": "1",
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1"
  }
}
