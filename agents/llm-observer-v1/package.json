{
  "name": "llm-observer-v1",
  "version": "1.0.0",
  "private": true,
  "description": "Survey agent: a language model reads the handover notes; a deterministic planner and two trained models do the rest",
  "type": "commonjs",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/agent.js",
    "models:predict": "node dist/tools/predict-models.js",
    "test:models": "node --test tests/models.cjs",
    "benchmark:models": "node dist/tools/benchmark-models.js",
    "pack": "npm run build && node dist/pack.js",
    "models:setup": "node runtime/setup.cjs",
    "notes:extract": "node dist/tools/handover-extract.js",
    "test:notes": "node --test tests/notes.cjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}
