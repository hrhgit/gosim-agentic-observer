{
  "name": "global-planner-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Gated local global planning research agent; policy deployment requires acceptance",
  "type": "commonjs",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/agent.js",
    "models:predict": "node dist/tools/predict-models.js",
    "test:models": "node --test tests/models.cjs",
    "benchmark:models": "node dist/tools/benchmark-models.js",
    "pack": "npm run build && node dist/pack.js",
    "models:setup": "node runtime/setup.cjs",
    "benchmark:legacy-models": "node dist/tools/benchmark-legacy-models.js",
    "test": "node --test tests/*.cjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}
