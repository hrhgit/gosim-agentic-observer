# Choose one named local profile below. Leave this blank to keep using the older
# MODEL_* settings immediately below; use deterministic to turn model calls off.
MODEL_PROFILE=deterministic

# Older one-model configuration, kept for compatibility.
# Deterministic mode needs no API package, network, account, or key.
MODEL_PROVIDER=deterministic
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_MODE=chat
MODEL_API_KEY_ENV=

# Named local profiles let one .env retain several services. Switch only
# MODEL_PROFILE (for example: deepseek or kimi_relay). Add another profile by
# copying these five MODEL_PROFILE_<NAME> fields; <NAME> uses letters, digits,
# underscores, or hyphens (hyphens become underscores in the field names).
MODEL_PROFILE_DEEPSEEK_PROVIDER=deepseek
MODEL_PROFILE_DEEPSEEK_NAME=
MODEL_PROFILE_DEEPSEEK_BASE_URL=
MODEL_PROFILE_DEEPSEEK_API_MODE=chat
MODEL_PROFILE_DEEPSEEK_API_KEY_ENV=DEEPSEEK_API_KEY

# Organizer's temporary Kimi relay: local development only, never a formal
# evaluation or submission credential. Paste your own s26-... token only into
# KIMI_RELAY_API_KEY below after selecting MODEL_PROFILE=kimi_relay.
MODEL_PROFILE_KIMI_RELAY_PROVIDER=kimi-relay
MODEL_PROFILE_KIMI_RELAY_NAME=kimi-for-coding
MODEL_PROFILE_KIMI_RELAY_BASE_URL=https://vdiemcofukuxglqsmlyz.supabase.co/functions/v1/kimi-relay/v1
MODEL_PROFILE_KIMI_RELAY_API_MODE=chat
MODEL_PROFILE_KIMI_RELAY_API_KEY_ENV=KIMI_RELAY_API_KEY

# On the platform (cloud runs and the official local project runner) OPENAI_BASE_URL
# and OPENAI_API_KEY are injected: the platform's model proxy and a temporary run
# credential. They take precedence over MODEL_BASE_URL and the provider keys below,
# and the proxy uses the model your team set on the Participate page. Never put a
# permanent key into a project ZIP or repository; pack_agent.py leaves .env out.
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Native providers: MODEL_PROVIDER=openai or anthropic.
# OpenAI defaults to Responses API when MODEL_API_MODE is omitted.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI-compatible profiles. Set MODEL_PROVIDER, MODEL_NAME, MODEL_BASE_URL,
# and the corresponding key. Endpoint URLs and model IDs come from each
# provider's current official documentation.
# Kimi Code (official subscription): use MODEL_PROVIDER=moonshot, MODEL_API_MODE=chat,
# MODEL_NAME=kimi-for-coding for K2.8 Preview or k3 for K3, and set MODEL_BASE_URL
# to https://api.kimi.ai/coding/v1 outside mainland China or
# https://api.kimi.com/coding/v1 inside mainland China. Put the Kimi Code Console
# key in KIMI_API_KEY below. Existing Moonshot Platform keys can stay in MOONSHOT_API_KEY.
KIMI_API_KEY=
# Token for the organizer's temporary local-development relay above.
KIMI_RELAY_API_KEY=
XAI_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_TOP_K_CANDIDATES=12
