# Supabase project used by this site (anon key only; never the service role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (auth redirects such as the password-reset link)
VITE_SITE_URL=https://your-hackathon.example.com

# URL path where the app is mounted. Must start and end with a slash.
VITE_BASE_PATH=/
